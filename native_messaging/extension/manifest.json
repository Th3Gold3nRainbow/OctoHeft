{
  "manifest_version": 3,
  "name": "OctoHeft Integration Module",
  "version": "1.1.0",
  "key": "",
  "description": "OctoMedia handoff, media sniffer, and high-speed download accelerator integration for OctoHeft",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "downloads",
    "webRequest",
    "nativeMessaging",
    "storage",
    "tabs",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
